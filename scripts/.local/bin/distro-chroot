#!/usr/bin/env bash
#
# distro-chroot: Mount and chroot into guest Linux distributions on ZFS
#

set -euo pipefail

POOL="${ZFS_POOL:-zpool}"
BASE_MNT="${CHROOT_BASE:-/mnt/chroot}"
USE_NSPAWN=false
MOUNT_BOOT=false
MOUNT_HOME=false
FORCE=false
CLEANUP_ON_EXIT=false
CURRENT_TARGET=""
RESOLV_MOUNTED=false
RESOLV_BACKUP=false

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
BOLD='\033[1m'
NC='\033[0m'

log_info() { echo -e "${BLUE}[INFO]${NC} $*"; }
log_ok() { echo -e "${GREEN}[OK]${NC} $*"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
log_err() { echo -e "${RED}[ERROR]${NC} $*" >&2; }

usage() {
	echo -e "${BOLD}Usage:${NC} $(basename "$0") [options] <distro|command> [args...]"
	echo ""
	echo -e "${BOLD}Commands:${NC}"
	echo -e "  ${GREEN}<distro> [cmd...]${NC}        Mount datasets, enter chroot (or exec cmd), and unmount on exit"
	echo -e "  ${GREEN}enter <distro> [cmd...]${NC}  Same as above"
	echo -e "  ${GREEN}mount <distro>${NC}           Mount datasets and API filesystems without entering"
	echo -e "  ${GREEN}umount <distro>${NC}          Safely unmount datasets and API filesystems"
	echo -e "  ${GREEN}list${NC}                     List detected distros in pool '${POOL}'"
	echo -e "  ${GREEN}status${NC}                   Show currently active mounts"
	echo ""
	echo -e "${BOLD}Options:${NC}"
	echo -e "  ${YELLOW}-n, --nspawn${NC}             Use systemd-nspawn instead of traditional chroot"
	echo -e "  ${YELLOW}-b, --boot${NC}               Mount /boot (EFI partition) into target"
	echo -e "  ${YELLOW}-h, --home${NC}               Mount guest home dataset into target /home"
	echo -e "  ${YELLOW}-p, --pool <name>${NC}        Specify ZFS pool (default: zpool)"
	echo -e "  ${YELLOW}-m, --mount-dir <dir>${NC}    Base mount path (default: /mnt/chroot)"
	echo -e "  ${YELLOW}-f, --force${NC}              Bypass host active-root safety check"
	echo -e "  ${YELLOW}--help${NC}                    Show this help message"
	echo ""
	echo -e "${BOLD}Examples:${NC}"
	echo -e "  sudo $(basename "$0") arch"
	echo -e "  sudo $(basename "$0") rhel"
	echo -e "  sudo $(basename "$0") ubuntu uname -a"
	echo -e "  sudo $(basename "$0") -b fedora"
}

check_root() {
	if [[ $EUID -ne 0 ]]; then
		log_err "This script requires root privileges. Please run with sudo."
		exit 1
	fi
}

get_available_distros() {
	zfs list -H -o name 2>/dev/null |
		grep -E "^${POOL}/[^/]+/root$" |
		sed -E "s|^${POOL}/([^/]+)/root$|\1|" |
		sort
}

is_current_host() {
	local distro="$1"
	local current_root
	current_root=$(findmnt -n -o SOURCE / 2>/dev/null || true)
	[[ "$current_root" == "${POOL}/${distro}/root" ]]
}

mount_zfs_dataset() {
	local dataset="$1"
	local target_dir="$2"

	mkdir -p "$target_dir"
	if mountpoint -q "$target_dir"; then
		return 0
	fi

	if ! mount -t zfs -o zfsutil "$dataset" "$target_dir" 2>/dev/null; then
		mount -t zfs "$dataset" "$target_dir"
	fi
}

mount_distro_datasets() {
	local distro="$1"
	local target="$2"

	log_info "Mounting datasets for '${distro}' at ${target}..."

	# 1. Mount root
	mount_zfs_dataset "${POOL}/${distro}/root" "$target"

	# 2. Mount /var if it exists
	if zfs list -H -o name "${POOL}/${distro}/var" >/dev/null 2>&1; then
		mount_zfs_dataset "${POOL}/${distro}/var" "${target}/var"
	fi

	# 3. Mount /nix if it exists (for NixOS)
	if zfs list -H -o name "${POOL}/${distro}/nix" >/dev/null 2>&1; then
		mount_zfs_dataset "${POOL}/${distro}/nix" "${target}/nix"
	fi

	# 4. Mount /home if requested
	if [[ "$MOUNT_HOME" == "true" ]] && zfs list -H -o name "${POOL}/${distro}/home" >/dev/null 2>&1; then
		mount_zfs_dataset "${POOL}/${distro}/home" "${target}/home"
	fi

	# 5. Mount /boot if requested
	if [[ "$MOUNT_BOOT" == "true" ]]; then
		local boot_target="${target}/boot"
		if [[ -d "${target}/boot/efi" ]]; then
			boot_target="${target}/boot/efi"
		elif [[ -d "${target}/efi" ]]; then
			boot_target="${target}/efi"
		fi
		mkdir -p "$boot_target"
		if [[ -d /boot ]] && mountpoint -q /boot; then
			mount --rbind /boot "$boot_target"
			mount --make-rslave "$boot_target"
		elif [[ -b /dev/disk/by-uuid/7E8B-C715 ]]; then
			mount /dev/disk/by-uuid/7E8B-C715 "$boot_target"
		fi
	fi
}

mount_api_filesystems() {
	local target="$1"

	mkdir -p "${target}/dev" "${target}/proc" "${target}/sys" "${target}/run" "${target}/tmp"

	mountpoint -q "${target}/dev" || (mount --rbind /dev "${target}/dev" && mount --make-rslave "${target}/dev")
	mountpoint -q "${target}/proc" || mount -t proc proc "${target}/proc"
	mountpoint -q "${target}/sys" || (mount --rbind /sys "${target}/sys" && mount --make-rslave "${target}/sys")
	mountpoint -q "${target}/run" || mount -t tmpfs tmpfs "${target}/run"
	mountpoint -q "${target}/tmp" || mount -t tmpfs -o mode=1777 tmpfs "${target}/tmp"

	# DNS configuration: prefer bind mount to avoid modifying guest files or altering SELinux context
	if [[ -f /etc/resolv.conf ]]; then
		mkdir -p "${target}/etc"
		if mount --bind -o ro /etc/resolv.conf "${target}/etc/resolv.conf" 2>/dev/null; then
			RESOLV_MOUNTED=true
		else
			if [[ -e "${target}/etc/resolv.conf" || -L "${target}/etc/resolv.conf" ]]; then
				if [[ ! -e "${target}/etc/resolv.conf.chroot-bak" ]]; then
					cp -P "${target}/etc/resolv.conf" "${target}/etc/resolv.conf.chroot-bak" 2>/dev/null || true
					RESOLV_BACKUP=true
				fi
				rm -f "${target}/etc/resolv.conf"
			fi
			cp -L /etc/resolv.conf "${target}/etc/resolv.conf" 2>/dev/null || true
		fi
	fi
}

unmount_target() {
	local target="$1"

	if [[ ! -d "$target" ]]; then
		return 0
	fi

	log_info "Cleaning up mounts under ${target}..."

	# Clean up resolv.conf
	if [[ "$RESOLV_MOUNTED" == "true" ]]; then
		umount "${target}/etc/resolv.conf" 2>/dev/null || true
		RESOLV_MOUNTED=false
	elif [[ "$RESOLV_BACKUP" == "true" ]]; then
		rm -f "${target}/etc/resolv.conf" 2>/dev/null || true
		mv -f "${target}/etc/resolv.conf.chroot-bak" "${target}/etc/resolv.conf" 2>/dev/null || true
		RESOLV_BACKUP=false
	fi

	# Recursively unmount target
	if findmnt -R "$target" >/dev/null 2>&1; then
		umount -R "$target" 2>/dev/null || {
			sleep 1
			umount -R -l "$target" 2>/dev/null || true
		}
	fi

	rmdir "$target" 2>/dev/null || true
	log_ok "Unmounted ${target}"
}

cleanup_handler() {
	if [[ "$CLEANUP_ON_EXIT" == "true" ]] && [[ -n "$CURRENT_TARGET" ]]; then
		echo ""
		log_warn "Trapped exit signal or session terminated. Running cleanup..."
		unmount_target "$CURRENT_TARGET"
	fi
}

trap cleanup_handler EXIT INT TERM

run_in_guest() {
	local target="$1"
	shift
	local cmd=("$@")

	if [[ ${#cmd[@]} -eq 0 ]]; then
		if [[ -x "${target}/bin/bash" ]]; then
			cmd=("/bin/bash" "-l")
		else
			cmd=("/bin/sh" "-l")
		fi
	fi

	if [[ "$USE_NSPAWN" == "true" ]]; then
		log_info "Entering guest with systemd-nspawn..."
		systemd-nspawn -q -D "$target" --bind-ro=/etc/resolv.conf "${cmd[@]}"
	else
		log_info "Entering guest with chroot..."
		chroot "$target" /usr/bin/env -i \
			HOME="/root" \
			TERM="${TERM:-xterm-256color}" \
			PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
			LANG="${LANG:-C.UTF-8}" \
			SYSTEMD_OFFLINE=1 \
			"${cmd[@]}"
	fi
}

enter_distro() {
	local distro="$1"
	shift
	local custom_cmd=("$@")

	if ! zfs list -H -o name "${POOL}/${distro}/root" >/dev/null 2>&1; then
		log_err "Distro root dataset '${POOL}/${distro}/root' not found."
		log_info "Run '$(basename "$0") list' to see available distros."
		exit 1
	fi

	if is_current_host "$distro" && [[ "$FORCE" != "true" ]]; then
		log_err "'${distro}' is the currently active host system! No chroot needed."
		log_info "Use --force if you intentionally want to mount it."
		exit 1
	fi

	local target="${BASE_MNT}/${distro}"
	CURRENT_TARGET="$target"
	CLEANUP_ON_EXIT=true

	mount_distro_datasets "$distro" "$target"
	if [[ "$USE_NSPAWN" != "true" ]]; then
		mount_api_filesystems "$target"
	fi

	set +e
	run_in_guest "$target" "${custom_cmd[@]}"
	local exit_code=$?
	set -e

	unmount_target "$target"
	CLEANUP_ON_EXIT=false
	return $exit_code
}

# Parse options
POSITIONAL_ARGS=()
while [[ $# -gt 0 ]]; do
	case "$1" in
	-n | --nspawn)
		USE_NSPAWN=true
		shift
		;;
	-b | --boot)
		MOUNT_BOOT=true
		shift
		;;
	-h | --home)
		MOUNT_HOME=true
		shift
		;;
	-p | --pool)
		POOL="$2"
		shift 2
		;;
	-m | --mount-dir)
		BASE_MNT="$2"
		shift 2
		;;
	-f | --force)
		FORCE=true
		shift
		;;
	--help)
		usage
		exit 0
		;;
	--)
		shift
		POSITIONAL_ARGS+=("$@")
		break
		;;
	*)
		POSITIONAL_ARGS+=("$1")
		shift
		;;
	esac
done

set -- "${POSITIONAL_ARGS[@]:-}"

ACTION="${1:-}"

if [[ -z "$ACTION" ]]; then
	usage
	exit 1
fi

case "$ACTION" in
list)
	echo -e "${BOLD}Detected Linux distros in ZFS pool '${POOL}':${NC}"
	available=$(get_available_distros)
	if [[ -z "$available" ]]; then
		echo "  (No distros found matching ${POOL}/*/root)"
	else
		for d in $available; do
			local_datasets=$(zfs list -H -o name -r "${POOL}/${d}" 2>/dev/null | tr '\n' ' ')
			if is_current_host "$d"; then
				echo -e "  ${GREEN}* ${d}${NC} ${YELLOW}(currently active host)${NC}"
			else
				echo -e "  ${BLUE}* ${d}${NC}"
			fi
			echo -e "    Datasets: ${local_datasets}"
		done
	fi
	;;

status)
	echo -e "${BOLD}Active mounts under '${BASE_MNT}':${NC}"
	if [[ -d "$BASE_MNT" ]]; then
		mounts=$(findmnt -R "$BASE_MNT" 2>/dev/null || true)
		if [[ -n "$mounts" ]]; then
			echo "$mounts"
		else
			echo "  (No active mounts)"
		fi
	else
		echo "  (Base mount directory '${BASE_MNT}' does not exist)"
	fi
	;;

mount)
	check_root
	DISTRO="${2:-}"
	[[ -z "$DISTRO" ]] && {
		log_err "Missing distro name. Usage: $0 mount <distro>"
		exit 1
	}
	target="${BASE_MNT}/${DISTRO}"
	mount_distro_datasets "$DISTRO" "$target"
	if [[ "$USE_NSPAWN" != "true" ]]; then
		mount_api_filesystems "$target"
	fi
	log_ok "Mounted '${DISTRO}' to ${target}."
	log_info "To unmount when done: sudo $(basename "$0") umount ${DISTRO}"
	;;

umount)
	check_root
	DISTRO="${2:-}"
	[[ -z "$DISTRO" ]] && {
		log_err "Missing distro name. Usage: $0 umount <distro>"
		exit 1
	}
	target="${BASE_MNT}/${DISTRO}"
	unmount_target "$target"
	;;

enter)
	check_root
	DISTRO="${2:-}"
	[[ -z "$DISTRO" ]] && {
		log_err "Missing distro name. Usage: $0 enter <distro>"
		exit 1
	}
	shift 2 || true
	enter_distro "$DISTRO" "$@"
	;;

*)
	# If user specified distro name directly: e.g. `distro-chroot arch`
	if zfs list -H -o name "${POOL}/${ACTION}/root" >/dev/null 2>&1; then
		check_root
		DISTRO="$ACTION"
		shift
		enter_distro "$DISTRO" "$@"
	else
		log_err "Unknown command or distro '${ACTION}'."
		echo ""
		usage
		exit 1
	fi
	;;
esac
